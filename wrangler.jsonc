{
  "name": "skemaraja-auto-checkin",
  "main": "_worker.js",
  "compatibility_date": "2024-01-01",
  "kv_namespaces": [
    {
      "binding": "CHECKIN_KV",
      "id": "dd8801d99ff44b39ae3cd1621f26d7ee"
    }
  ],
  "triggers": {
    "crons": [
      "30 23 * * 1-5",
      "30 4 * * 1-5",
      "30 8 * * 1-5"
    ]
  },
  "vars": {
    "AUTH_PASSWORD": "admin123"
  }
}
